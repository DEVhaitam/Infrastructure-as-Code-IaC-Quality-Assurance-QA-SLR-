keywords = {Hartree ansatz, Semiclassical limit, Periodic potential, Homogenization, Vlasov–Poisson equation, Moment method, Nonstrictly hyperbolic systems},
abstract = {This work is concerned with the semiclassical approximation of the Schrödinger–Poisson equation modeling ballistic transport in a 1D periodic potential by means of WKB techniques. It is derived by considering the mean-field limit of a N-body quantum problem, then K-multivalued solutions are adapted to the treatment of this weakly nonlinear system obtained after homogenization without taking into account for Pauli’s exclusion principle. Numerical experiments display the behaviour of self-consistent wave packets and screening effects.}
}
@article{WANG2025111694,
title = {DSTrack: Diffusion-based sequence learning for visual object tracking},
journal = {Pattern Recognition},
volume = {168},
pages = {111694},
year = {2025},
issn = {0031-3203},
doi = {https://doi.org/10.1016/j.patcog.2025.111694},
url = {https://www.sciencedirect.com/science/article/pii/S0031320325003541},
author = {Zhixing Wang and Kai Wang and Chuanming Tang and Xiang Li and Jianlin Zhang and Lianli Gao},
keywords = {Visual tracking, Diffusion models, Sequence learning},
abstract = {Visual object tracking (VOT) is vital in pattern recognition. Traditional methods often use classification and regression heads. Recent autoregressive methods in visual tracking, treating tracking as bounding-box sequence generation, have shown better performance by framing tracking as discrete sequence generation. These approaches convert bounding box coordinates to discrete tokens in a shared vocabulary for sequential regression. However, this shift from a continuous to a discrete representation introduces quantization and positional biases, adversely affecting performance with larger vocabularies. To overcome this constraint, we propose a diffusion-based sequence learning tracking approach, named DSTrack. In this method, we employ the diffusion model to predict bounding-box coordinates in a parallel manner and transform the discrete variable distribution estimation into continuous probability distribution estimation. Furthermore, to enhance the representational prowess of the Vision Transformer (ViT) backbones, we amplify the pre-trained ViT model by integrating additional Ladder modules. This strategic enhancement is designed to effectively bridge the gaps between different dataset domains. This novel diffusion-based sequence learning paradigm theoretically circumvents the constraints of the discrete token vocabulary and improves tracking performance. With fair comparison in our experiments, the proposed DSTrack achieves state-of-the-art results on benchmark datasets such as LaSOT and TrackingNet.}
}
@article{WANG2005207,
title = {Reconstruction of structured scenes from two uncalibrated images},
journal = {Pattern Recognition Letters},
volume = {26},
number = {2},
pages = {207-220},
year = {2005},
issn = {0167-8655},
doi = {https://doi.org/10.1016/j.patrec.2004.08.024},
url = {https://www.sciencedirect.com/science/article/pii/S0167865504002296},
author = {Guanghui Wang and Hung-Tat Tsui and Zhanyi Hu},
keywords = {Plane induced homography, Camera calibration, 3D reconstruction, Absolute conic, Structured scene},
abstract = {This paper investigates a practical heuristics method for reconstruction of structured scenes from two uncalibrated images. The method is based on an initial estimation of principal homographies from 2D initial point matches that may contain some outliers, and the homographies are refined recursively by incorporating the supporting matches of both points and lines on principal space surfaces. Then epipolar geometry is recovered directly from the refined homographies and cameras are calibrated from three orthogonal vanishing points and the recovered infinite homography. There are several points of novelty. First, a simple homography-guided method for matching line segments between two views is proposed. Second, under the assumption of zero-skew, the cameras are auto-calibrated with all the four intrinsic parameters varying between the two views. The advantages of the method is that it can build more realistic models with minimal human interactions, and it also allows us to reconstruct more visible surfaces on the detected planes than traditional methods which can only reconstruct the overlapping parts, since the homography provides a one-to-one mapping of points and lines between different views. Extensive experiments with real images illustrate the validity and advantages of the proposed method.}
}
@article{LIGHT20121158,
title = {Monitoring Winter Ice Conditions Using Thermal Imaging Cameras Equipped with Infrared Microbolometer Sensors},
journal = {Procedia Computer Science},
volume = {10},
pages = {1158-1165},
year = {2012},
note = {ANT 2012 and MobiWIS 2012},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2012.06.166},
url = {https://www.sciencedirect.com/science/article/pii/S1877050912005236},
author = {Janet Light and Subashini Parthasarathy and William McIver},
keywords = {Ice condition, monitoring, thermal imaging, microbolometer sensors},
abstract = {Snow cover duration and thickness affects the permafrost thermal state, the depth and timing of seasonal soil freeze/thaw/break-up, and melting of on land and sea ice. Monitoring the ice conditions in lakes and rivers during a winter season is critical for the safety of people living in those regions. Infrared cameras equipped with microbolometer sensors, placed near lakes and rivers during winter, captures and send those thermal images wirelessly to a server, where image processing and analysis algorithms measure the ice conditions in real-time. This study presents results from an ice classification system using captured ice images.}
}
@article{YANG2024100637,
title = {More than a framework: Sketching out technical enablers for natural language-based source code generation},
journal = {Computer Science Review},
volume = {53},
pages = {100637},
year = {2024},
issn = {1574-0137},
doi = {https://doi.org/10.1016/j.cosrev.2024.100637},
url = {https://www.sciencedirect.com/science/article/pii/S1574013724000212},
author = {Chen Yang and Yan Liu and Changqing Yin},
keywords = {Source code generation, NL2Code, Software engineering, Machine learning application},
abstract = {Natural Language-based Source Code Generation (NLSCG) holds the promise to revolutionize the way how software is developed by means of facilitating a collection of intelligent technical enablers, based on sustained improvements on the natural language to source code pipelines and continuous adoption of new coding paradigms. In recent years, a large variety of NLSCG technical solutions have been proposed, and quite exciting experimental results have been reported. Meanwhile, current researches and initiative application projects in this area reflect a large diversity of NLSCG contexts and of major technical enablers. Such heterogeneity, fragmentation, and vagueness of the NLSCG technical landscape are currently frustrating the full realization of the NLSCG research and application vision. Players in this field could not find systematic guidelines on how to effectively address the ”known unknowns” and how to simply spot the ”unknown unknowns”, which eventually hinder the turning of NLSCG solutions into further research enhancements or production applications. Understanding the context, boundaries, capabilities, and integrations of NLSCG enablers is considered as one of the key drivers for the more practical application of NLSCG models. In this paper, we analyze in detail the natural language to source code pipelines and the evolvement of source code generation tasks, by considering both the problem context and technological aspects. A foresight reference framework for NLSCG is proposed to help handle the source code generation tasks with proper intelligent models. We review the present-day NLSCG technical landscape, as well as the core technical enablers along the source code generation pipelines. Relevant experiments are conducted to validate the role of representative models across different technical enablers on typical datasets, and we finally highlight the contribution of different enablers to code generation capabilities.}
}
@article{BHARADWAJ200966,
title = {Effects of information technology failures on the market value of firms},
journal = {The Journal of Strategic Information Systems},
volume = {18},
number = {2},
pages = {66-79},
year = {2009},
issn = {0963-8687},
doi = {https://doi.org/10.1016/j.jsis.2009.04.001},
url = {https://www.sciencedirect.com/science/article/pii/S0963868709000158},
author = {Anandhi Bharadwaj and Mark Keil and Magnus Mähring},
keywords = {IT failure, Event study, Resource-based view},
abstract = {IT failures abound but little is known about the financial impact that these failures have on a firm’s market value. Using the resource-based view of the firm and event study methodology, this study analyzes how firms are penalized by the market when they experience unforeseen operating or implementation-related IT failures. Our sample consists of 213 newspaper reports of IT failures by publicly traded firms, which occurred during a 10-year period. The findings show that IT failures result in a 2% average cumulative abnormal drop in stock prices over a 2-day event window. The results also reveal that the market responds more negatively to implementation failures affecting new systems than to operating failures involving current systems. Further, the study demonstrates that more severe IT failures result in a greater decline in firm value and that firms with a history of IT failures suffer a greater negative impact. The implications of these findings for research and practice are discussed.}
}
