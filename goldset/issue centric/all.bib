doi = {https://doi.org/10.1016/j.compstruc.2014.06.002},
url = {https://www.sciencedirect.com/science/article/pii/S0045794914001345},
author = {Jin Ho Lee and Jae Kwan Kim and Jung Han Kim},
keywords = {Nonlinear analysis, Material nonlinearity, Soil–structure interaction, Wave propagation, Layered half-space, Perfectly matched discrete layer},
abstract = {When nonlinear behaviors of soil are important in a soil–structure interaction system, radiation of energy into the infinity of the soil as well as the nonlinearity must be considered rigorously. In this study, perfectly matched discrete layers (PMDLs) are employed to represent the radiation of energy rigorously. A time-domain formulation for a soil–structure interaction is given using the layers. To represent a layered half-space effectively and accurately, a method to determine PMDL parameters for the half-space is proposed. It is demonstrated that the proposed PMDL system can be applied successfully to problems of nonlinear soil–structure interaction.}
}
