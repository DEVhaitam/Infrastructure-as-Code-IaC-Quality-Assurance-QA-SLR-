url = {https://www.sciencedirect.com/science/article/pii/0169755289900688},
author = {Sudhir Aggarwal and Zvi Har'el},
keywords = {Simulation, Software Environments, Analysis and Verification, Protocols, Formal Description Techniques, Software Tools.},
abstract = {There is increasing interest in specialized software environments that make it easy for users to quickly learn and use new software tools. One such environment is SPANNER whose goal is to make it convenient to specify and analyze communication protocols. In this paper, we describe SIMUL, an integrated subcomponent that facilitates the simulation analysis of protocols. The user interface makes it easy to setup and make simulation runs, directly from a formal specification of the protocol. Thus, complex protocols can be analyzed by simulations that take into account timing constraints and probabilistic choices.}
}
