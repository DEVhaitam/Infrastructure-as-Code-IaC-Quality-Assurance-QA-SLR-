author = {Lester J. Walters and Thomas J. Wolery},
abstract = {Program SALT performs the simultaneous solution of equations for mass balance and mass action describing chemical equilibrium in complex aqueous systems. The basic mass-action and mass-balance equations are transformed into two monotone cosequences which converge rapidly to give an error-bounded solution set. Although program SALT is designed for the major cations and ions of natural waters, it can be easily modified to solve problems containing any number of cations or anions and any number of possible complexes, and it also can be used as a subroutine in programs designed to solve larger scale geochemical problems.}
