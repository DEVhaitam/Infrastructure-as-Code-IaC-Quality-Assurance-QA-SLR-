@article{DEFLORIANI1981253,
title = {A graphical system for geographical data processing in a minicomputer environment},
journal = {Signal Processing},
volume = {3},
number = {3},
pages = {253-257},
year = {1981},
issn = {0165-1684},
doi = {https://doi.org/10.1016/0165-1684(81)90041-4},
url = {https://www.sciencedirect.com/science/article/pii/0165168481900414},
author = {L. {De Floriani} and G. Dettori and B. Falcidieno and C. Pienovi and V. Gianuzzi},
keywords = {Geographic data processing, automated cartography, graphic systems, contour mapping, interactive editors},
abstract = {In this paper a minicomputer system for geographical data processing for computer cartography applications is described. The main features of the system are: capability of processing irregularly distributed data points; interactive facility during the editing and map refinement steps; modular organization; use of minicomputer systems with standard display devices. At present the system is used to produce isarithmic maps for nautical applications.
Zusammenfassung
In diesem Artikel wird ein Minicomputersystem beschrieben, das geographische Daten für die kartographie verarbeitet. Die wesentlichen Eigenschaften des Systems sind: es ist in der Lage, unregelmäβig verteilte Datenpunte zu verarbeiten; interaktiver Zugang während der Phase der Eingabe und Korrektur der Karte; modulare Organisation; Gebrauch von Minicomputersystemen mit Standardgeräten zur graphischen Ausgabe. Zum gegenwärtigen Zeitpunkt wird das System dazu benutzt, Spezialkarten für nautische Anwendungen zu erstellen.
Résumé
On décrit dans cet article un système de miniordinateur pour le traitement des données géographiques avec application à la cartographie par ordinateur. Les caractéristiques principales du système sont: aplitude à traiter des points irrégulièrement distribués; possibilité d'interaction pendant l'édition et le raffinement de la carte; organisation modulaire; utilisation de systèmes de miniordinateurs avec des affichages standards. A présent, le système est utilisé pour produire des cartes isarithmiques pour des applications nautiques.}
}
@article{HOLLAWAY2020100103,
title = {Tackling the Challenges of 21st-Century Open Science and Beyond: A Data Science Lab Approach},
journal = {Patterns},
volume = {1},
number = {7},
pages = {100103},
year = {2020},
issn = {2666-3899},
doi = {https://doi.org/10.1016/j.patter.2020.100103},
url = {https://www.sciencedirect.com/science/article/pii/S2666389920301379},
author = {Michael J. Hollaway and Graham Dean and Gordon S. Blair and Mike Brown and Peter A. Henrys and John Watkins},
keywords = {DataLabs, data science, virtual, collaborative, transparent, multi-disciplinary, big data},
abstract = {Summary
In recent years, there has been a drive toward more open, cross-disciplinary science taking center stage. This has presented a number of challenges, including providing research platforms for collaborating scientists to explore big data, develop methods, and disseminate their results to stakeholders and decision makers. We present our vision of a “data science lab” as a collaborative space where scientists (from different disciplines), stakeholders, and policy makers can create data-driven solutions to environmental science's grand challenges. We set out a clear and defined research roadmap to serve as a focal point for an international research community progressing toward a more data-driven and transparent approach to environmental data science, centered on data science labs. This includes ongoing case studies of good practice, with the infrastructural and methodological developments required to enable data science labs to support significant increase in our cross- and trans-disciplinary science capabilities.}
}
@article{TASDEMIR201292,
title = {A hybrid method combining SOM-based clustering and object-based analysis for identifying land in good agricultural condition},
journal = {Computers and Electronics in Agriculture},
volume = {83},
pages = {92-101},
year = {2012},
issn = {0168-1699},
doi = {https://doi.org/10.1016/j.compag.2012.01.017},
url = {https://www.sciencedirect.com/science/article/pii/S0168169912000300},
author = {Kadim Taşdemir and Pavel Milenov and Brooke Tapsall},
keywords = {Land cover identification, Unsupervised clustering, Self-organizing maps, CONN linkage, Object based image analysis, Good agricultural condition},
abstract = {Remotely sensed imagery is currently used as an efficient tool for agricultural management and monitoring. In addition, the use of remotely sensed imagery in Europe has been extended towards determination of the areas potentially eligible for the farmer subsidies under the Common Agricultural Policy (CAP), through interactive or automatic land cover identification. For accurate quantification and fast identification of agricultural land cover areas from the imagery, a hybrid method, which combines automated clustering of self-organizing maps with object based image analysis, and called SOM+OBIA, is proposed. Performance analysis on three test zones (using multi-temporal Rapideye imagery) indicates that for the basic land cover categories (forest, water, vegetated areas, bare areas and sealed surfaces), unsupervised classification with the proposed SOM+OBIA method achieves an identification accuracy comparable to the accuracy of the traditional interactive object oriented analysis, with considerably less user interaction.}
}
@article{TOPPEN1998199,
