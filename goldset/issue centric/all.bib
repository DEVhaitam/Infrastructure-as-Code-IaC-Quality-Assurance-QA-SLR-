author = {Limoncelli, Thomas A.},
title = {GitOps: A Path to More Self-service IT: IaC + PR = GitOps},
year = {2018},
issue_date = {May-June 2018},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
