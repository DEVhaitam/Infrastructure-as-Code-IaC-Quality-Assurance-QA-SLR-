@article{SPITALERI1994907,
title = {Visual numerical environment: reference models, methods and tools},
journal = {Computer-Aided Design},
volume = {26},
number = {12},
pages = {907-916},
year = {1994},
issn = {0010-4485},
doi = {https://doi.org/10.1016/0010-4485(94)90056-6},
url = {https://www.sciencedirect.com/science/article/pii/0010448594900566},
author = {Rosa Maria Spitaleri},
keywords = {numerical simulation, visualization, reference models},
abstract = {The paper presents a few fundamental components of a visual numerical environment for handling computational simulations: the reference models representing the ideal basis of its development, the grid generation cycle coupling numerical methods and visualization techniques, and an integrated system of software modules for user applications. Along with the reference model of the whole simulation cycle, submodels detail relationships among numerical and visual processes. Focusing on the grid generation subcycle, multigrid grid generation, basic grid visualization and analysis are described. The model is applied to classify methods and tools as a means of validation. Stepwise lists of object classes and instances are proposed. The model's consistency is verified with both method application and programming. Computational steering seems to be promising in realizing advanced visual numerical environments.}
}
@article{THIRUNARAYAN2005215,
