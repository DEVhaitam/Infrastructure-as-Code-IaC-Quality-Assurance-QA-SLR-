publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {9},
number = {1},
issn = {0163-6103},
url = {https://doi.org/10.1145/1102505.1102508},
doi = {10.1145/1102505.1102508},
abstract = {The construction of a simulation model proceeds from a statement of objectives, through hypothesis choice and formulation, to computer implementation and model experiments. Even the best of the modern simulation languages provide good support for only a portion of these activities. Ideally, we might specify objectives and environment and have the "system" develop the appropriate simulation model. We do not appear to be ready for such a system for several reasons: 1. The way in which objectives specify model structure is quite an art at the present, and while scenarios can be constructed in which certain properties of the model structure are clearly dictated by objectives, as yet the full model structure does not follow algorithmically from objectives; 2. A language for objective specification is needed. A natural language is too broad and ambiguous; 3. Ecosystem theory is not yet up to the task of defining, in detail, the ecosystem that would exist in a given environment although certain properties of that system can be predicted.},
journal = {SIGSIM Simul. Dig.},
month = sep,
pages = {9–10},
numpages = {2}
}

