	author = {Dehury, Chinmaya Kumar and Srirama, Satish Narayana},
	year = {2026},
	keywords = {Microservice architecture, Microservice communication, Microservices, Monolithic architecture, OpenAPI, REST API, Service decomposition, Swagger},
	pages = {65--90},
}

@article{too_enhancing_2025,
	title = {Enhancing maritime cyber situational awareness: {A} cybersecurity visualisation for non-experts},
	volume = {154},
	issn = {0167-4048},
	url = {https://www.sciencedirect.com/science/article/pii/S0167404825001221},
	doi = {https://doi.org/10.1016/j.cose.2025.104433},
	abstract = {Cyber situational awareness is key to mitigating the impacts of cyber threats. However, maritime falls short of its comparative industries, with very little attention given to cyber threats despite the growing concern. In this paper, we explore the use of visualisations as a way to improve the situational awareness of non-experts onboard ships. We designed a visualisation tool with focus on systems that are accessible once onboard. In order to elicit requirements for our visualisations, we conducted semi-structured interviews with experts. We further created a synthetic dataset of attacks that target the systems of ships, which we used to assess the usability of our visualisation. In order to evaluate our visualisations, we conducted a user study with both expert and non-expert users. Our results show that non-expert participants were able to accurately and efficiently detect synthetic attacks targeting ships in an experimental setting, and they were able to use the visualisation to consider what the consequences of these attacks might be. Expert evaluations further suggest the visualisation has merit as a training tool for raising awareness among maritime employees.},
	journal = {Computers \& Security},
	author = {Too, Dominic and Axon, Louise and Agrafiotis, Ioannis and Goldsmith, Michael and Creese, Sadie},
	year = {2025},
	keywords = {Cyber–physical systems, Intrusion detection, Maritime, Situational awareness, Visualisation},
	pages = {104433},
}

