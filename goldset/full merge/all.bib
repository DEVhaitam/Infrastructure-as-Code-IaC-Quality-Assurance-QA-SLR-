@inproceedings{10.1145/800191.805661,
author = {Kerner, Helmut and Beyerle, Werner},
title = {A simulator generator based on formal descriptions of architectural, load,and operating system models},
year = {1976},
isbn = {9781450374897},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
