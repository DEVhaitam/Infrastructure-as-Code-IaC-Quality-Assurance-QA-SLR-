	title = {Chapter 10 - {Agere} {Systems}–{Communications} {Optimized} {PayloadPlus} {Network} {Processor} {Architecture}},
	issn = {15459888},
	url = {https://www.sciencedirect.com/science/article/pii/B9781558608757500284},
	doi = {https://doi.org/10.1016/B978-155860875-7.50028-4},
	abstract = {Publisher Summary PayloadPlus refers to a complete OC-48c network processing solution. The three-chip solution performs all of the classification, policing, traffic management, quality-of-service (QoS) or class-of-service (CoS), traffic-shaping, and packet modification functions needed for a carrier-class networking platform. It is noted that the PayloadPlus product family represents a technological advance in the construction of intelligent communication equipment capable of layer 2-7 processing. The PayloadPlus network processor family includes the fast pattern processor (FPP), routing switch processor (RSP), and the Agere system Interface (ASI). The ASI provides an industry-standard peripheral component interconnect (PCI) interface between a host processor and Agere's high-speed processors for control and management functions, including routing table and virtual circuit updates, hardware configuration, and exception handling. The ASI also assists the FPP in policing both cell and packet-based traffic at up to OC-48c rates, maintaining state information on data flows and capturing statistics. PayloadPlus essentially demonstrates a communications focused architecture.},
	booktitle = {Network {Processor} {Design}},
	publisher = {Morgan Kaufmann},
	author = {Klein, Bill and Garza, Juan},
	year = {2003},
	pages = {219--233},
}

@article{ye_prioritized_2026,
	title = {Prioritized {Experience} {Replay} and {Four}-{Trajectory} {Exploration} - {Multi}-agents {Proximal} {Policy} {Optimization}: {Multi}-agents {Reinforcement} {Learning}-{Based} service migration strategy under vehicular edge computing},
	volume = {129},
	issn = {0045-7906},
	url = {https://www.sciencedirect.com/science/article/pii/S0045790625007797},
	doi = {https://doi.org/10.1016/j.compeleceng.2025.110836},
	abstract = {With the improvement of Intelligent Transportation Systems (ITS), Vehicular Edge Computing (VEC), which integrates roadside computing devices, can provide essential computing and storage resources for road vehicles. However, the high mobility of vehicles and the limited processing capacity of Roadside Units (RSUs) bring significant challenges for service migration, particularly in real-time decisions and resource scheduling. To address these challenges, this study proposes a real-time service migration strategy that leverages Artificial Intelligence (AI) technologies specifically Deep Reinforcement Learning (DRL)to optimize Quality of Service (QoS) and reduce response latency. Firstly, to solve the real-time decision problem, Prioritized Experience Replay and Four-Trajectory Exploration (PERFT), recurrent neural networks, and attention mechanisms are incorporated into the Proximal Policy Optimization (PPO) algorithm, yielding the Prioritized Experience Replay and Four-Trajectory Exploration Proximal Policy Optimization (PERFT-PPO). Then, to meet the multi-agents resource scheduling demands under VEC, the Centralized Training with Decentralized Execution (CTDE) framework is integrated into PERFT-PPO, resulting in the Prioritized Experience Replay and Four-Trajectory Exploration Multi-Agent Proximal Policy Optimization (PERFT-MAPPO) algorithm, which coordinates resource allocation among agents while enhancing global long-term rewards. Experimental results demonstrate significant improvements in real-time decisions and overall system performance.},
	journal = {Computers and Electrical Engineering},
	author = {Ye, Lei and Chen, Yulan and Han, Qingwen and Zeng, Lingqiu and Ling, Kaiwen},
	year = {2026},
	keywords = {AI, Multi-agents, PERFT-MAPPO, PERFT-PPO, VEC},
	pages = {110836},
}

@article{wang_text_2015,
	title = {Text detection approach based on confidence map and context information},
	volume = {157},
	issn = {0925-2312},
	url = {https://www.sciencedirect.com/science/article/pii/S0925231215000442},
	doi = {https://doi.org/10.1016/j.neucom.2015.01.023},
	abstract = {Text information plays a significant role in many applications for providing more descriptive and abstract information than other objects. In this paper, an approach based on the confidence map and context information is proposed to robustly detect texts in natural scenes. Most of the conventional methods design sophisticated texture features to describe the text regions, while we focus on building a confidence map model by integrating the seed candidate appearance and the relationships with its adjacent candidates to highlight the texts from the backgrounds, and the candidates with low confidence value will be removed. In order to improve the recall rate, the text context information is adopted to regain the missing text regions. Finally, the text lines are formed and further verified, and the words are obtained by calculating the threshold to separate the intra-word letters from the inter-word letters. Experimental results on the three public benchmark datasets, i.e., ICDAR 2005, ICDAR 2011 and ICDAR 2013, show that the proposed approach has achieved the competitive performances by comparing with the other state-of-the-art methods.},
	journal = {Neurocomputing},
	author = {Wang, Runmin and Sang, Nong and Gao, Changxin},
	year = {2015},
	keywords = {Confidence map, Connected component analysis, Context information, Scene text detection, Texture feature},
	pages = {153--165},
}

