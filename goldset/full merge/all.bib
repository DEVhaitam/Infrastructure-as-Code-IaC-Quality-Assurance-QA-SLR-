@article{phillips_natural_1984,
	title = {Natural convection in an enclosed cavity},
	volume = {54},
	issn = {0021-9991},
	url = {https://www.sciencedirect.com/science/article/pii/0021999184901232},
	doi = {https://doi.org/10.1016/0021-9991(84)90123-2},
