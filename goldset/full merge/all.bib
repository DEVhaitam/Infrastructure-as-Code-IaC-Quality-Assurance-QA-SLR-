@inproceedings{10.5555/963600.963662,
author = {Mesiti, Marco and Bertino, Elisa and Guerrini, Giovanna},
title = {An abstraction-based approach to measuring the structural similarity between two unordered XML documents},
year = {2003},
publisher = {Trinity College Dublin},
abstract = {Measuring the structural similarity between two document-centric XML documents is a well-known problem. Many approaches have been proposed that, by fixing constraints in the evaluation of similarity, compute the similarity with polynomial time complexity. Despite this huge activity for document-centric XML documents, no approaches have been presented so far for data-centric XML documents (i.e., XML documents for which order among elements is not relevant) mainly because this problem is, in general, NP-complete. In this paper we propose an approach for measuring the structural similarity between two data-centric XML documents that, when the structure of elements with the same label is not heterogenous, is polynomial.},
