}

@article{gosse_multiphase_2004-1,
	title = {Multiphase semiclassical approximation of an electron in a one-dimensional crystalline lattice {II}. {Impurities}, confinement and {Bloch} oscillations},
	volume = {201},
	issn = {0021-9991},
	url = {https://www.sciencedirect.com/science/article/pii/S0021999104002335},
