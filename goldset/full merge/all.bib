doi = {10.1145/800191.805661},
abstract = {The time needed for designing a simulator often hampers or even eliminates its use for the evaluation of computer systems. In order to alleviate this design effort a simulator generator which is driven by formalized descriptions of the hardware, the workload and the operating system is presented. This paper concentrates on the descriptions of the three defining models. These descriptions guide the simulator designer in the selection of pertinent facts from natural language sources and provide a short notation of the data and structures of the three submodels. The structure of the description languages encourages modularization of the simulator. A large variety of simulators can be generated through composition from a growing set of such modules.},
