	author = {Shimonski, Robert J. and Schmied, Will and Shinder, Thomas W. and Chang, Victor and Simonis, Drew and Imperatore, Damiano},
	year = {2003},
	pages = {667--726},
}

@article{navas_reconciling_2013,
	title = {Reconciling run-time evolution and resource-constrained embedded systems through a component-based development framework},
	volume = {78},
	issn = {0167-6423},
	url = {https://www.sciencedirect.com/science/article/pii/S0167642312001633},
