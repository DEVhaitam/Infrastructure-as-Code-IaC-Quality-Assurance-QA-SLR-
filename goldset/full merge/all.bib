	pages = {263--272},
}

@article{vaziri_impedance_1994,
	title = {Impedance functions to model boundary zones with non-reflection interface properties},
	volume = {50},
	issn = {0045-7949},
	url = {https://www.sciencedirect.com/science/article/pii/0045794994903026},
	doi = {https://doi.org/10.1016/0045-7949(94)90302-6},
	abstract = {A new model is presented for characterizing the response of soils within the boundary zone around piles. The proposed concept provides for a continuous variation of soil properties with smooth transition into the outer zone; these properties alleviate the wave reflections from the interface between the two media. With this model the impedances of composite layer do not show the oscillations that are generally observed with the other boundary zone models that take account of the soil mass. In this regard, the proposed formulations have satisfactorily corrected for the problems associated with wave reflections in the boundary zone. Furthermore, as in reality the interface between the two media is fictitious, the non-reflection properties are considered to improve the credibility of the theoretical analysis for practical problems. To develop the proposed model, the differential equation for the vertically excited layer is solved using hypergeometric functions; the impedances of the composite layer and the pile are then derived with different parameters of the boundary zone. The developed impedance functions are used in the dynamic analysis of a field problem involving vertical vibration of a single pile. Comparison of the theoretical predictions with the experimental data in this ease indicates that inclusion of the boundary zone results in a reduction in the stiffness and damping for the pile-soil system which in turn causes a reduction in the resonant frequencies and an increase in the resonant amplitude of piles. The results show that the proposed boundary zone model improves the agreement between the theoretical predictions and field-measured data.},
	number = {2},
	journal = {Computers \& Structures},
	author = {Vaziri, H. H.},
	year = {1994},
	pages = {263--272},
}

