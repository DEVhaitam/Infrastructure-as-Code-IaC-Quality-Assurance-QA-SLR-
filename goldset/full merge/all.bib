@article{kawai_graph_1978,
	title = {A graph theoretic formulation of bit pattern algorithms for graphics},
	volume = {7},
	issn = {0146-664X},
	url = {https://www.sciencedirect.com/science/article/pii/S0146664X7880015X},
	doi = {https://doi.org/10.1016/S0146-664X(78)80015-X},
	abstract = {A graph theoretic formulation of bit pattern algorithms for computer graphics is presented. A two-dimensional N×N bit array, called the canvas memory, is used to formulate the concepts of domain, boundary curve, and scanning, which are used to describe basic picture processing algorithms such as scan conversion, domain partitioning, inclusion test, scissoring, and cross point detection. the basis of the formulation is given in terms of point set, cycle in dual graph, and pseudo-Hamiltonian path. Except for the computational time complexity of scan conversion, which is inherently quadratic, O(N2), in terms of the resolution N, linear (O(N)) algorithms for all the other basic picture processing operations are presented.},
