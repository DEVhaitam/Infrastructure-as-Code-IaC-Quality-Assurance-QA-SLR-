@incollection{li_4_2007,
	address = {Burlington},
	series = {The {Morgan} {Kaufmann} {Series} in {Networking}},
	title = {4 - {DHCPv6}},
	issn = {18759351},
	url = {https://www.sciencedirect.com/science/article/pii/B9780123704795500057},
	doi = {https://doi.org/10.1016/B978-012370479-5/50005-7},
	abstract = {Publisher Summary This chapter discusses the Dynamic Host Configuration Protocol for Internet Protocol version 6 (DHCPv6). It provides the technical background for DHCPv6—including the protocol specification and common usage models. The chapter describes the KAMEs implementation of DHCPv6 along with examples of working of the protocol. The primary usage of DHCPv6 is to allocate IPv6 addresses to a client. This is conceptually the same as the main role of Dynamic Host Configuration Protocol for Internet Protocol version 4 (DHCPv4)—a server is configured with a block of IPv6 addresses to lease, and clients ask the server for some of those addresses to configure their network interfaces. Although this is the original goal of the DHCPv6 protocol, it is somewhat less important than the same provision of DHCPv4; in IPv6, there is another mechanism for a host to configure its IPv6 addresses automatically: stateless address autoconfiguration. The ways in which the DHCPv6 protocol is essentially identical to DHCPv4 are: both protocols are based on the client-server model. The objective of the protocols is to provide network configuration information from a server to a client.},
