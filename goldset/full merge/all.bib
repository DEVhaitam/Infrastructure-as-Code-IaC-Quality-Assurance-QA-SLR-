@inproceedings{10.5555/800013.809537,
author = {Crabbs, David E. and Clymer, John R.},
title = {Operational evaluation modeling of automatic speaker verification systems},
year = {1984},
publisher = {IEEE Press},
abstract = {This study uses operational evaluation techniques to model a system which processes human speech to verify the identity persons seeking access to a facility resource. The system consists of hardware and software for accepting analog speech; extracting time, frequency, and amplitude characteristics; producing compact digital templates containing the features for speaker identification; and cross-referencing templates with reference patterns establish the degree of similarity between utterence and a set of utterences for the person whose identity is being claimed. decision algorithm is implemented determine whether the speaker is valid or imposter based on the degree of similarity observed.A conceptual model has been tested and used to simulate variations in system attributes in order to optimize system performance. Performance is evaluated in terms of number of imposters who can defeat system, and the number of rejected valid speakers.},
booktitle = {Proceedings of the 16th Conference on Winter Simulation},
pages = {752–761},
numpages = {10},
location = {Dallas, TX},
series = {WSC '84}
}

@inproceedings{10.1145/3631991.3632005,
author = {Nishiura, Kinari and Ikeda, Kaito and Sasakura, Mariko and Monden, Akito},
title = {Exploring Behavioral Trustworthiness of Github Developers},
year = {2023},
isbn = {9798400708053},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3631991.3632005},
doi = {10.1145/3631991.3632005},
abstract = {In recent years, many companies demand to hire developers who are active on GitHub, making it increasing important to know the activities and characteristics of developers on GitHub. To date, researchers aim to analyze developer characteristics on GitHub, such as software library skills and types of contributions. However, these studies have not focused on the developers’ "trustworthiness", which we believe it extremely important when working with a team because an untrustworthy developer, no matter how skilled, is difficult to entrust with important tasks. In this paper we focus on the developers’ trustworthiness, and try to quantify their behaviors potentially related to trustworthiness, such as the issue accomplishment rate and the average issue accomplishment time. This paper analyzes developers of two well-known OSS projects, React and Python, and show the quantitative evidence on their trustworthiness.},
booktitle = {Proceedings of the 2023 5th World Symposium on Software Engineering},
pages = {92–95},
numpages = {4},
keywords = {GitHub, behavioral characteristics, mining software repositories, software metrics, trustworthiness},
location = {Tokyo, Japan},
series = {WSSE '23}
}

