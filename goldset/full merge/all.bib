	issn = {2212-0173},
	url = {https://www.sciencedirect.com/science/article/pii/S2212017312005786},
	doi = {https://doi.org/10.1016/j.protcy.2012.10.033},
	abstract = {Digital watermarking has an important application to protect and authenticate the medical images. To perform accordingly one of the most commonly used methods is region based operation, i.e. the whole image is partitioned into two regions called region of interest (ROI) and region of non-interest (RONI). The ROI contained all important information from diagnosis point of view which could not be altered or distorted by any further operation and need reversibility i.e. complete recovery of the data through detection on the other end. The RONI contained some information (patient information, hospital logo etc.) for authentication; hence demands are robustness against various attack operations. Here we have proposed a joint robust and reversible watermarking scheme that shows its efficiency in terms of integrity, authenticity and robustness.},
