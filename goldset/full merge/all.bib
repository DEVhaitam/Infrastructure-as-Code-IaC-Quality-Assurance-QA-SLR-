	author = {Kumar, Rohit and Agrawal, Neha},
	year = {2023},
	keywords = {Cloud computing, Edge computing, Edge–Fog–Cloud framework, Fog computing, Industrial Internet of Things (IIoT), Internet of Things (IoT), Multi-Dimensional Data},
	pages = {100504},
}

@article{commenges_deconvolution_1982,
