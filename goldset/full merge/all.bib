	volume = {186},
	issn = {0169-2607},
	url = {https://www.sciencedirect.com/science/article/pii/S0169260719314026},
	doi = {https://doi.org/10.1016/j.cmpb.2019.105204},
	abstract = {Background and Objective: The paper focuses on the numerical strategies to optimize a plasmid DNA delivery protocol, which combines hyaluronidase and electroporation. Methods: A well-defined continuum mechanics model of muscle porosity and advanced numerical optimization strategies have been used, to propose a substantial improvement of a pre-existing experimental protocol of DNA transfer in mice. Our work suggests that a computational model might help in the definition of innovative therapeutic procedures, thanks to the fine tuning of all the involved experimental steps. This approach is particularly interesting in optimizing complex and costly protocols, to make in vivo DNA therapeutic protocols more effective. Results: Our preliminary work suggests that computational model might help in the definition of innovative therapeutic protocol, thanks to the fine tuning of all the involved operations. Conclusions: This approach is particularly interesting in optimizing complex and costly protocols for which the number of degrees of freedom prevents a experimental test of the possible configuration.},
	journal = {Computer Methods and Programs in Biomedicine},
	author = {Peri, Daniele and Deville, Manon and Poignard, Clair and Signori, Emanuela and Natalini, Roberto},
	year = {2020},
	keywords = {Gene Gene Electrotransfer Administration, Non-linear oprimization, Parameter identification},
