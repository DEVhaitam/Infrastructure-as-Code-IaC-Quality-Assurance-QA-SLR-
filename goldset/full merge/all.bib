@incollection{dehury_chapter_2026-6,
	title = {Chapter 4 - {Microservices}},
	isbn = {978-0-443-45032-7},
	url = {https://www.sciencedirect.com/science/article/pii/B9780443450327000043},
	doi = {https://doi.org/10.1016/B978-0-443-45032-7.00004-3},
	abstract = {In this chapter, we will explore the transformative journey of microservices, a paradigm shift that is redefining the architectural landscape for DevOps professionals. As organizations transition from traditional, tightly integrated monolithic architectures to more dynamic and resilient microservice architectures, understanding the nuances and methodologies of this transition becomes essential. Microservice architecture is a design approach in software development where an application is structured as a collection of small, autonomous services, each performing a specific function. We will explore the foundational principles of monolithic and microservice architectures, examining their respective strengths and challenges. Additionally, this chapter will introduce OpenAPI and Swagger, powerful tools that facilitate the design, documentation, and management of APIs within microservice infrastructures. By the end of this chapter, you will gain a comprehensive understanding of how these technologies interplay to enhance scalability, flexibility, and maintainability in software development, equipping you with the knowledge to innovate and excel in the evolving landscape of DevOps.},
	booktitle = {Mastering {DevOps}},
