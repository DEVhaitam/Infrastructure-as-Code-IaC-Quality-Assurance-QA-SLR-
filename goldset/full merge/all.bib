	issn = {0166-218X},
	url = {https://www.sciencedirect.com/science/article/pii/0166218X9090067M},
	doi = {https://doi.org/10.1016/0166-218X(90)90067-M},
	abstract = {A matrix of the form A = (QT) is called a layered mixed matrix (or an LM-matrix) if the nonzero entries of T are algebraically independent over the field to which the entries of Q belong. The rank of an LM-matrix is known to be characterized by a submodular function, say p, defined on the column set C. This function p has played a central role in establishing the block-triangular canonical form, called the CCF, of an LM-matrix. In this paper, the principal structure of the submodular system (C,p), in the sense of Fujishige, is characterized in terms of the block-triangularization of the submatrices of A: The principal structure of (C,p) is the coarsest decomposition of C which is finer than all the decompositions of C induced by the CCF of the submatrix consisting of a base of the row vectors of A. Its significance to the structural analysis of systems of equations is also discussed.},
	number = {3},
	journal = {Discrete Applied Mathematics},
	author = {Murota, Kazuo},
	year = {1990},
	keywords = {combinatorial canonical form (CCF), Dulmage—Mendelsohn decomposition, Layered mixed matrix, principal structure., submodular system},
	pages = {221--234},
}

