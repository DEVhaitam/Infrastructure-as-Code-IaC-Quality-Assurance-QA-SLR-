	volume = {17},
	issn = {1930-1650},
	url = {https://www.sciencedirect.com/science/article/pii/S1930165023000067},
	doi = {https://doi.org/10.4018/IJISP.317371},
	abstract = {ABSTRACT IoT devices generate enormous amounts of data, which deep learning algorithms can learn from more effectively than shallow learning algorithms. The approach for threat detection may ultimately benefit fog computing or fog networking (fogging). The authors present a cutting-edge distributed DL method for detecting cyberattacks and vulnerability injection (CAVID) in this paper. In terms of the evaluation metrics tested in the tests, the DL model performs better than the SL models. They demonstrated a distributed DL-driven fog computing CAVID approach using the open-source NSL-KDD dataset. A pre-trained SAE was utilised for feature engineering, whereas Softmax was employed for categorization. They used parametric evaluation for system assessment to evaluate the model in comparison to SL techniques. For scalability, accuracy across several worker nodes was taken into consideration. In addition to the robustness, effectiveness, and optimization of distributed parallel learning among fog nodes for enhancing accuracy, the findings demonstrate DL models exceeding classic ML architectures.},
	number = {1},
	journal = {International Journal of Information Security and Privacy},
	author = {Rawat, Romil and Chakrawarti, Rajesh Kumar and Vyas, Piyush and Gonzáles, José Luis Arias and Sikarwar, Ranjana and Bhardwaj, Ramakant},
	year = {2023},
	keywords = {Auto-Encoder, Cyber Threat, Cyber-Attack, Deep Learning, Fog Computing, IoT, Security, Shallow Learning},
}

@incollection{raj_chapter_2026,
	series = {Advances in {Computers}},
	title = {Chapter {Twelve} - {Evolution} of software engineering: {From} traditional to modern approaches},
	volume = {141},
	issn = {0065-2458},
	url = {https://www.sciencedirect.com/science/article/pii/S0065245825001081},
	doi = {https://doi.org/10.1016/bs.adcom.2025.06.017},
	abstract = {The field of making software has grown a lot. We need faster ways to build, scale, and keep software running well. Picking the right way to develop software is key as it gets more complex and users expect more. Over time, we have seen many methods for project management. From old ways like Waterfall to newer ones like Agile and iterative development. Modern ways focus on being flexible, working together, and delivering on time, so teams can change with new needs and tech. Today’s development uses tools like cloud, DevOps, and automation, boosting speed and quality. New ideas like microservices and AI are changing software by easing tasks and solving new issues. This chapter looks at current methods in software engineering, sharing their rules, upsides, and best uses for different projects. Knowing these ways helps teams decide well and make great software that meets user needs and business aims.},
