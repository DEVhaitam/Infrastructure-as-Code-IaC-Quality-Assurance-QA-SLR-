	url = {https://www.sciencedirect.com/science/article/pii/0898122177900955},
	doi = {https://doi.org/10.1016/0898-1221(77)90095-5},
	abstract = {The results of a study dealing with the location of stable corrector methods for the numerical solution of ordinary differential equations are reported. From each family of corrector methods of the order q + 1 which require function evaluations at q backpoints (3 ≤ q ⩽ 8), methods are given for which the size of a relative stability disk was numerically optimized. The resulting methods are also shown to have larger regions of absolute stability than do the corresponding Adams-Moulton correctors.},
	number = {3},
	journal = {Computers \& Mathematics with Applications},
	author = {Rodabaugh, David and Thompson, Skip},
	year = {1977},
	pages = {197--201},
}

@article{galil_cyclic_1977,
	title = {Cyclic ordering is {NP}-complete},
