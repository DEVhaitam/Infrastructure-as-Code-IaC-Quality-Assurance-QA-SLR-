@inproceedings{10.1145/2973839.2973845,
author = {de Fran\c{c}a, Breno B. Nicolau and Jeronimo, Helvio and Travassos, Guilherme Horta},
title = {Characterizing DevOps by Hearing Multiple Voices},
year = {2016},
isbn = {9781450342018},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/2973839.2973845},
doi = {10.1145/2973839.2973845},
abstract = {Recently, DevOps has emerged as an alternative for software organizations inserted into a dynamic market to handle daily software demands. As claimed, it intends to make the software development and operations teams to work collaboratively. However, it is hard to observe a shared understanding of DevOps, what potentially hinders the discussions in the literature and can confound observations when conducting empirical studies. Therefore, we performed a Multivocal Literature Review aiming at characterizing DevOps in multiple perspectives, including data sources from technical and gray literature. Grounded Theory procedures were used to rigorous analyze the collected data. It allowed us to achieve a grounded definition for DevOps, as well as to identify its recurrent principles, practices, required skills, potential benefits, challenges and what motivates the organizations to adopt it. Finally, we understand the DevOps movement has identified relevant issues in the state-of-the-practice. However, we advocate for the scientific investigations concerning the potential benefits and drawbacks as a consequence of adopting the suggested principles and practices.},
booktitle = {Proceedings of the XXX Brazilian Symposium on Software Engineering},
pages = {53–62},
numpages = {10},
keywords = {Software Development and Operations, Multivocal Literature Review, Grounded Theory, DevOps},
location = {Maring\'{a}, Brazil},
series = {SBES '16}
}

@inproceedings{10.1145/3581784.3607086,
author = {Guerrero Balaguera, Juan David and Rodriguez Condia, Josie Esteban and Fernandes Dos Santos, Fernando and Sonza Reorda, Matteo and Rech, Paolo},
title = {Understanding the Effects of Permanent Faults in GPU's Parallelism Management and Control Units},
year = {2023},
isbn = {9798400701092},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3581784.3607086},
doi = {10.1145/3581784.3607086},
abstract = {Modern Graphics Processing Units (GPUs) demand life expectancy extended to many years, exposing the hardware to aging (i.e., permanent faults arising after the end-of-manufacturing test). Hence, techniques to assess permanent fault impacts in GPUs are strongly required, especially in safety-critical domains.This paper presents a method to evaluate permanent faults in the GPU's scheduler and control units, together with the first figures to quantify these effects. We inject 5.83x105 permanent faults in the gate-level units of a GPU model. Then, we map the observed error categories as software errors by instrumenting 13 applications and two convolutional neural networks, injecting more than 1.65x105 permanent errors (1,000 errors per application), reducing evaluation times from several years to hundreds of hours. Our results highlight that faults in GPU parallelism management units impact software execution parameters. Moreover, errors in resource management or instructions codes hang the code, while 45% of errors induce silent data corruption.},
booktitle = {Proceedings of the International Conference for High Performance Computing, Networking, Storage and Analysis},
articleno = {46},
numpages = {14},
keywords = {error models, fault injection, GPUs, permanent faults, reliability},
location = {Denver, CO, USA},
series = {SC '23}
}

@inproceedings{10.1145/3631991.3632005,
author = {Nishiura, Kinari and Ikeda, Kaito and Sasakura, Mariko and Monden, Akito},
title = {Exploring Behavioral Trustworthiness of Github Developers},
year = {2023},
isbn = {9798400708053},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3631991.3632005},
doi = {10.1145/3631991.3632005},
abstract = {In recent years, many companies demand to hire developers who are active on GitHub, making it increasing important to know the activities and characteristics of developers on GitHub. To date, researchers aim to analyze developer characteristics on GitHub, such as software library skills and types of contributions. However, these studies have not focused on the developers’ "trustworthiness", which we believe it extremely important when working with a team because an untrustworthy developer, no matter how skilled, is difficult to entrust with important tasks. In this paper we focus on the developers’ trustworthiness, and try to quantify their behaviors potentially related to trustworthiness, such as the issue accomplishment rate and the average issue accomplishment time. This paper analyzes developers of two well-known OSS projects, React and Python, and show the quantitative evidence on their trustworthiness.},
booktitle = {Proceedings of the 2023 5th World Symposium on Software Engineering},
pages = {92–95},
numpages = {4},
keywords = {GitHub, behavioral characteristics, mining software repositories, software metrics, trustworthiness},
location = {Tokyo, Japan},
series = {WSSE '23}
}

