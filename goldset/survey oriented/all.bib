keywords = {general-purpose compiler, embedded compiler, twig, instruction selection, template matching, rewriting rules, ASIP instruction description, register liveness, clique, graph coloring, VLIW register files, scheduling constraint modeling, combined instruction selection, register allocation, scheduling, trace-based analysis, program structure + traces, code placement by profiling, trace placement as ILP, types of memory optimizations, ideal parallelism, optimization strategy, loop transformations, polytope model, loop transformations, matrices, non-unimodular transformations, non-unimodular transformations, memory layout transformations, loops and energy, reliability, real-time Java, general strategies, strategies for streaming, buffer management, dynamic memory management, data transfer, storage management, loop transformations and buffering, buffer analysis, cache hit rate improvement, prefetching, scalar variable placement, array placement, combined data and loop transformations, scratch pads, scratch pad management, scratch pad allocation algorithms, burst modes, paged addressing mechanisms, banked memories, performance measures, uses of average performance, uses of WCET and BCET, performance analysis challenges, performance from instructions, variations in CPU performance, computability and path analysis, path analysis by ILP, path constraints, cache behavior and paths, user constraints, loop iterations, parametric timing analysis, clustered analysis, instruction caching, abstract interpretation, abstract interpretation and ILP, simulation-based timing analysis, probabilistic timing models, timing bounds and security, synchronous languages, video drivers, NDL, interrupt programming disciplines, synchronous data flow, schedulability, buffer management in SDFs, SPI, LUSTRE, compiling distributed implementations, Compaan, GALS languages, control and reactive systems, control decomposition, STATEMATE, Statechart interpretation, Statechart verification, Esterel, compiling Esterel, bytecodes, compact virtual machines, just-in-time compilation, when to use JIT compiler, JIT compilation, coordination languages, Metropolis},
abstract = {This chapter covers programs. The back end of the compilation process, which helps determine the quality of the code, is the first topic. The chapter extensively covers memory system optimizations since memory behavior is a prime determinant of both performance and energy consumption. It covers performance analysis including both simulation and worst-case execution time analysis. It also considers how models of computing are reflected in programming models and languages.}
}
@article{ALBOAIE20201531,
title = {Self-Sovereign Applications: return control of data back to people},
journal = {Procedia Computer Science},
volume = {176},
pages = {1531-1539},
year = {2020},
note = {Knowledge-Based and Intelligent Information & Engineering Systems: Proceedings of the 24th International Conference KES2020},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2020.09.164},
url = {https://www.sciencedirect.com/science/article/pii/S1877050920320640},
author = {Sînică Alboaie and Nicu-Cosmin Ursache and Lenuța Alboaie},
keywords = {Self-Sovereign Application, SSApp, Privacy, EDFS, Dossier, DSU},
abstract = {This article presents new solutions for the difficult problem of data protection. The discussion in our approach will be based on the premise that data needs to be shared between the adequate number of entities under a set of strict rules. In this context, our proposal consists of a suite of privacy and data control focused approaches that become the building blocks for Self-Sovereign Applications (SSApps). SSApps are a new class of applications proposed for the first time in this paper and are aimed to ensure data ownership and proper data control for people and companies. The building blocks for SSApps consist of the insights that the role of blockchain should be reduced to ensure data anchoring of data shared between multiple participants. The blockchain ensures integrity and data provenance but should not be used for storing any private data. Therefore, the data is stored in off-chain storages that are structured in the form of a new approach called Data Sharing Units (DSU or Dossier). A method for performant implementation of SSApps, Dossiers and anchoring is proposed in this article.}
}
