doi = {https://doi.org/10.1016/B978-012370479-5/50005-7},
url = {https://www.sciencedirect.com/science/article/pii/B9780123704795500057},
author = {Qing Li and Tatuya Jinmei and Keiichi Shima},
abstract = {Publisher Summary
This chapter discusses the Dynamic Host Configuration Protocol for Internet Protocol version 6 (DHCPv6). It provides the technical background for DHCPv6—including the protocol specification and common usage models. The chapter describes the KAMEs implementation of DHCPv6 along with examples of working of the protocol. The primary usage of DHCPv6 is to allocate IPv6 addresses to a client. This is conceptually the same as the main role of Dynamic Host Configuration Protocol for Internet Protocol version 4 (DHCPv4)—a server is configured with a block of IPv6 addresses to lease, and clients ask the server for some of those addresses to configure their network interfaces. Although this is the original goal of the DHCPv6 protocol, it is somewhat less important than the same provision of DHCPv4; in IPv6, there is another mechanism for a host to configure its IPv6 addresses automatically: stateless address autoconfiguration. The ways in which the DHCPv6 protocol is essentially identical to DHCPv4 are: both protocols are based on the client-server model. The objective of the protocols is to provide network configuration information from a server to a client.}
}
@article{ZHANG2010711,
title = {Automatic 3D model reconstruction of cutting tools from a single camera},
journal = {Computers in Industry},
volume = {61},
number = {7},
pages = {711-726},
year = {2010},
issn = {0166-3615},
doi = {https://doi.org/10.1016/j.compind.2010.05.009},
url = {https://www.sciencedirect.com/science/article/pii/S0166361510000825},
author = {Xi Zhang and Wai-Ming Tsang and Masahiko Mori and Kazuo Yamazaki},
keywords = {Cutting tools, Surface of revolution, Single view reconstruction},
abstract = {Collision detection by machining simulation requires the 3D models of rotating cutters. However, the 3D models of a cutter and holder are not always available. In this paper, a new method is proposed to design an automatic vision-based 3D modeling system, which is able to quickly reconstruct the 3D model of a cutter and holder when they are installed onto the spindle. Only a single camera is mounted on the machine tool to capture the image of the rotating cutter and holder. By viewing the rotating cutter and holder as an object of surface of revolution, the contour of the imaged cutter and holder can be used to reconstruct the 3D model as a stack of circular cross-sections. Then the complete generating function of the cutter and holder can be recovered from the cross-sections. Finally, the 3D model of the cutter is built by rotating the generating function around the spindle axis. The effectiveness and accuracy of the proposed method are verified by experiments on-machine using 12 kinds of cutters and holders, which can satisfy the requirement of collision detection.}
}
@incollection{LEBOUDEC199759,
title = {A CAC algorithm for VBR connections over a VBR trunk},
editor = {V. Ramaswami and P.E. Wirth},
series = {Teletraffic Science and Engineering},
publisher = {Elsevier},
volume = {2},
pages = {59-70},
year = {1997},
booktitle = {Teletraffic Contributions for the Information Age},
issn = {1388-3437},
doi = {https://doi.org/10.1016/S1388-3437(97)80012-1},
url = {https://www.sciencedirect.com/science/article/pii/S1388343797800121},
author = {Jean-Yves {Le Boudec} and Arnis Ziediņš},
abstract = {We propose an algorithm for connection admission control (CAC) in the case where connections are of the variable bit rate (VBR) type and the trunk carrying the multiplexed VBR connections is itself a VBR connection. The latter assumption occurs for example when a number of ATM connections is multiplexed over one VBR virtual path connection, or when a number of IP/RSVP flows is multiplexed over one VBR virtual channel connection. The algorithm is based on the proportional allocation method. We apply the algorithm to compare on some examples the multiplexing gain obtained by (1) aggregating a number of VBR connections into a VBR trunk (2) into a CBR trunk or (3) without aggregation. These preliminary results show that the use of VBR trunks makes it possible to aggregate a number of connections into one without sacrificing bandwidth efficiency.}
}
@article{WEI2025131313,
title = {Frequency-sensitive diffusion model for personalized sequential recommendation},
journal = {Neurocomputing},
volume = {654},
pages = {131313},
year = {2025},
issn = {0925-2312},
doi = {https://doi.org/10.1016/j.neucom.2025.131313},
url = {https://www.sciencedirect.com/science/article/pii/S092523122501985X},
author = {Lina Wei and Ruoxin Ni and Jinhui Wei and Yuncheng Jiang},
keywords = {Sequential recommendation, Diffusion model, Frequency domain},
abstract = {Sequence recommendation (SR) is crucial for many applications, aiming to predict users’ next interactions based on their history. However, data sparsity and the long-tail problem remain challenges. Some models use data augmentation to address these issues, but often rely on rigid global distributions and embedding variations, neglecting dynamic fluctuations in data. This leads to low-quality content that fails to meet users’ needs. To address this, we propose a novel frequency-aware diffusion model for personalized sequence recommendation (FSDRec). FSDRec constructs an adaptive information-enhanced framework to address dynamic changes in user preferences. It detects shifts in user behavior and integrates both global and local information by selectively retaining high- and low-frequency signals during noise addition, effectively adapting to evolving user needs. A harmonic attention mechanism, based on time intervals, guides the noise restoration in the reverse process. FSDRec also employs a frequency ramp structure to comprehensively capture data features, enhancing prediction accuracy through contrastive learning. Extensive experiments conducted on four benchmark datasets demonstrate that FSDRec achieves superior performance compared to state-of-the-art methods, particularly showing significant improvements of 13.8 % in NDCG@5 on ML-1 M and 7.0 % in HR@10 on the Sports dataset.}
}
@article{LEWIS1973427,
title = {Computer reduction and analysis of neurophysiological data with special emphasis on evoked potential frequency analysis},
journal = {Computers in Biology and Medicine},
volume = {3},
number = {4},
pages = {427-436},
year = {1973},
issn = {0010-4825},
doi = {https://doi.org/10.1016/0010-4825(73)90007-3},
url = {https://www.sciencedirect.com/science/article/pii/0010482573900073},
author = {Gregory W. Lewis},
keywords = {Complex signal analysis, Frequency analysis, Computer analysis, Neurophysiology, Evoked potential, Electrophysiology},
abstract = {A hardware and software system is described for the acquisition, reduction and analysis of neurophysiological data. Application pertains to EEG and EEG-derived evoked potential records. Determination is made of frequency component information in the records using a Fast Fourier Transform algorithm. The frequency information is represented as power spectra estimates (PSE), which are later selected, averaged and input to a multivariate discriminant statiscal package. Control of the software system is made via remote terminal and acoustic coupler, allowing the use of off-site computer support. Sample results are provided.}
}
@incollection{TEKINERDOGAN202413,
title = {Chapter 2 - Critical infrastructures: Key concepts and challenges},
editor = {Bedir Tekinerdogan and Mehmet Akşit and Cagatay Catal and William Hurst and Tarek Alskaif},
booktitle = {Management and Engineering of Critical Infrastructures},
publisher = {Academic Press},
pages = {13-52},
year = {2024},
isbn = {978-0-323-99330-2},
doi = {https://doi.org/10.1016/B978-0-323-99330-2.00011-8},
url = {https://www.sciencedirect.com/science/article/pii/B9780323993302000118},
author = {Bedir Tekinerdogan and Mehmet Akşit and Cagatay Catal and Tarek Alskaif and William Hurst},
keywords = {Critical infrastructures, Challenges, Survey},
abstract = {This chapter provides an overview of the key concepts of critical infrastructures, which are essential for the functioning of modern societies. The chapter includes an introduction to the topic, definitions of critical infrastructures, and a metamodel that describes the complex relationships between the different components of these infrastructures. The chapter also discusses key concepts such as resilience, interdependency, risk, cybersecurity, and physical security, and how they relate to critical infrastructures. Additionally, the chapter describes a feature model that can be used to identify and prioritize features necessary for ensuring the resilience and security of critical infrastructures. The chapter concludes by emphasizing the importance of understanding these concepts for protecting critical infrastructures from a wide range of physical and cyber threats.}
}
@article{MASCARI1994111,
