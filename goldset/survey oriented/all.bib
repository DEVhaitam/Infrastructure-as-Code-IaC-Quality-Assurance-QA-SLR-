author = {Kenneth David Strang},
keywords = {Empirical surface mine case study, Queue model, Statistical nonparametric hypothesis testing, Spreadsheet software},
abstract = {This case study uses empirical data gathered at an Australian refinery to verify the assumptions for queue distributions before using special-purpose software to plan the off-road-truck hauling of titanium dioxide to a refinery (n=773). Easy-to-use spreadsheet software is utilized to verify assumptions for queue models. Managers are able to make decisions based on economic implications of queue models to avoid making costly planning mistakes. Analysts can use nonparametric hypothesis-testing techniques to verify distribution assumptions for optimization without having to write hard-to-maintain and complex algebraic linear equations or nonlinear search routines.}
}
@incollection{KASUKAWA200259,
