@incollection{1989172,
title = {Chapter C Recursiveness and Complexity.},
editor = {E. Börger},
series = {Studies in Logic and the Foundations of Mathematics},
publisher = {Elsevier},
volume = {128},
pages = {172-334},
year = {1989},
booktitle = {Computability, Complexity, Logic},
issn = {0049-237X},
doi = {https://doi.org/10.1016/S0049-237X(08)70322-7},
url = {https://www.sciencedirect.com/science/article/pii/S0049237X08703227},
abstract = {Publisher Summary
New concepts must be built for the complexity analysis of decidable problems to describe mathematically and study the experience of various kinds of grades of difficulty of recursive problems. The general approach of quantitative analysis is made by first classifying decidable problems and of computable functions by classifying the space and time requirements of their solution- or computation-procedures. In the example of primitive recursive functions—an important subclass of all recursive functions—it is proved that these quantitative determinations of complexity fit in with natural complexity measures by which the algorithms are classified by their structure (program- and definition-complexity).Variations of simulation and diagonalization techniques led to infinite hierarchies of solvable problems of growing complexity. The coding procedures discussed show that the essential difficulties in the question of the practical solution of decidable problems already occur in the conflict between complexity classes with sets with polynomial- and sets with exponential- computation expense. In the light of the concepts and results encountered in the complexity analysis of recursive problems, the question of the mathematical concept of algorithm is posed. The chapter discusses the complexity classes of recursive functions and primitive recursive functions, polynomial and exponential bounded complexity classes, and two basic ideas of computation theory—finite automata and context-free grammars (languages).}
}
