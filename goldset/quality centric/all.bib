@article{PATEL2026108118,
title = {DevOps research across a decade: Patterns, trends, and insights with LDA},
journal = {Information and Software Technology},
volume = {195},
pages = {108118},
year = {2026},
issn = {0950-5849},
doi = {https://doi.org/10.1016/j.infsof.2026.108118},
url = {https://www.sciencedirect.com/science/article/pii/S0950584926001072},
author = {Akshit Raj Patel and Sulabh Tyagi and Deepak Sharma},
keywords = {DevOps, Agile software development, Topic modeling, Latent Dirichlet Allocation (LDA), Trend analysis, Continuous integration},
abstract = {Context:
Software organizations continuously strive to release high-quality software both on time and on demand. Over the past decade, DevOps-related publications have significantly increased, emphasizing the need to identify core research areas and emerging trends that can assist researchers in understanding and analyzing patterns within this dynamic field.
Objective:
To uncover research patterns through topic modeling analysis of DevOps research articles published between 2011∼2024.
Methods:
This study employs pre-processing techniques to convert text into vector representations, which are then input into a Latent Dirichlet Allocation (LDA) topic model to identify underlying research patterns. The optimal number of topics is determined based on topic coherence scores.
Results:
The LDA topic modeling technique was applied to a decade-long dataset of research articles. The analysis identified a range of research topics and their temporal trends, while also highlighting key DevOps themes across different publication sources. Prominent research topics include Infrastructure as Code (IaC) for cloud service provisioning and management, test automation in DevOps environments, containerization, security enhancement in DevSecOps pipelines, and build-and-release management. These areas reflect the maturation of DevOps research and its growing alignment with industry priorities, particularly in automation, security, and efficient software delivery.
Conclusion:
This research synthesizes DevOps research trends based on an analysis of 405 research articles. The identified patterns and trends offer guidance for future researchers, helping them to discover potential research areas within the field.}
}
