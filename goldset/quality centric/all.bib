@inproceedings{10.1145/3702191.3705513,
author = {Han, Xiaoyu and Yang, Jianfeng and Zhou, Tao},
title = {Optimization Control of Multi-port Energy Router Based on Model Predictive Control},
year = {2025},
isbn = {9798400718229},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3702191.3705513},
doi = {10.1145/3702191.3705513},
abstract = {This paper focuses on the control strategy design and implementation for a five-port energy router. First, the topological structure of the energy router is analyzed, and control methods for each port are proposed based on the core functional requirements of the energy router. Specifically, the grid unit port adopts a current-loop vector control strategy to ensure the stability of the DC bus voltage. The AC source unit port uses a VSR (Voltage Source Rectifier) topology, implementing flexible power adjustment through PQ control. The photovoltaic (PV) unit port is based on a Boost converter, combined with Maximum Power Point Tracking (MPPT) and DC bus voltage control (CVC) strategies to optimize energy conversion efficiency. The energy storage unit port is managed using a Buck-Boost converter, with a model predictive control (MPC) strategy to regulate the charging and discharging processes of the energy storage unit. Based on these control strategies for each port, a collaborative control approach for the five-port system is further proposed. This approach divides the operation modes of the energy router according to the type of distributed energy sources connected and the state of charge (SOC) of the energy storage unit. Smooth mode transitions are achieved by utilizing key state data such as DC bus voltage fluctuations and SOC of the storage unit. Finally, to validate the feasibility of the proposed collaborative control strategy and mode switching, a simulation platform was built using MATLAB, and detailed simulations were performed. The simulation results show that the designed five-port energy router can efficiently manage energy and perform flexible mode switching, providing strong support for the stable operation of energy internet systems.},
booktitle = {Proceedings of the 2024 International Symposium on Integrated Circuit Design and Integrated Systems},
pages = {271–281},
numpages = {11},
keywords = {Collaborative Control, Energy Management, Mode Switching, Model Predictive Control},
location = {
},
series = {ICDIS '24}
}

